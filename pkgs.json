    "dependencies": ["glib", "pixman", "freetype", "fontconfig"],
    "enabled": true
  },
  "java": {
    "pkg_version":"25.0.1",
    "pkg_url": "https://download.oracle.com/java/25/archive/jdk-25.0.1_linux-x64_bin.tar.gz",
    "inst_type":"unpack",
    "pkgconf": "java",
    "dependencies": ["glib", "pixman", "freetype", "fontconfig"],
    "enabled": true
